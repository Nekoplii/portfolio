---
// SidebarDrawer.astro - Architectural Grid Slide-Over Drawer
import { ArrowUpRight, GitBranch, Mail, X } from 'lucide-astro';

const navItems = [
  { index: '01', name: 'Home', href: '/', desc: 'Overview, systems engineering & 3D grid' },
  { index: '02', name: 'Projects', href: '#projects', desc: 'Open-source software, desktop & web apps' },
  { index: '03', name: 'Tech Stack', href: '#techstack', desc: 'Languages, runtimes & system tools' },
  { index: '04', name: 'Designs', href: '#designs', desc: 'Architectural visual paradigms & UI systems' },
  { index: '05', name: 'Contact', href: '#contact', desc: 'Direct inquiries & communication channel' },
];
---

<div 
  id="sidebar-drawer-root" 
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 opacity-0"
  aria-hidden="true"
>
  <!-- Backdrop with smooth fade -->
  <div 
    id="sidebar-backdrop" 
    class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity opacity-0"
  ></div>

  <!-- Slide-out Drawer Panel in Architectural Grid Style -->
  <aside 
    id="sidebar-panel" 
    class="absolute top-0 right-0 bottom-0 w-full max-w-sm sm:max-w-md bg-[#0f121a] border-l border-white/10 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
  >
    <!-- Top Corner Crosshairs '+' -->
    <div class="absolute top-2.5 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
    <div class="absolute top-2.5 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>

    <div>
      <!-- Drawer Header -->
      <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img 
            src="https://media.mafly.my.id/logo/primary.svg" 
            alt="Mafly Logo" 
            class="h-7 w-auto object-contain"
          />
          <div>
            <span class="text-sm font-bold text-white tracking-tight block">Mafly</span>
          </div>
        </div>

        <button 
          id="sidebar-close-btn"
          type="button"
          aria-label="Close sidebar"
          class="p-2 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-slate-300 hover:text-white transition-all cursor-pointer active:scale-95"
        >
          <X class="w-4 h-4" />
        </button>
      </div>

      <!-- Section Indicator Bar -->
      <div class="px-6 py-2.5 border-b border-white/10 flex items-center justify-between font-mono text-[11px] bg-white/[0.01]">
        <span class="text-[#ff8600] font-semibold">NAVIGATION //</span>
        <span class="text-slate-400">DIRECTORY</span>
      </div>

      <!-- Navigation Links: Contiguous Divided List -->
      <nav class="divide-y divide-white/10 border-b border-white/10">
        {navItems.map((item) => (
          <a 
            href={item.href}
            class="sidebar-nav-link group px-6 py-4 flex items-center justify-between hover:bg-white/[0.02] transition-colors"
          >
            <div class="flex items-center gap-4">
              <span class="text-xs font-mono text-[#ff8600] group-hover:text-[#ffa033] transition-colors">{item.index} //</span>
              <div>
                <span class="text-sm font-semibold text-white group-hover:text-[#ff8600] transition-colors block">
                  {item.name}
                </span>
                <span class="text-xs text-slate-400 block line-clamp-1">
                  {item.desc}
                </span>
              </div>
            </div>
            <ArrowUpRight class="w-4 h-4 text-slate-500 group-hover:text-[#ff8600] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0 ml-2" />
          </a>
        ))}
      </nav>
    </div>

    <!-- Drawer Footer -->
    <div class="border-t border-white/10 p-6 space-y-4 bg-white/[0.01]">
      <div class="grid grid-cols-2 gap-3">
        <!-- Direct Email Link -->
        <a 
          href="mailto:code.mafly@gmail.com" 
          class="p-2.5 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] border border-white/10 text-xs font-mono text-slate-300 hover:text-white transition-colors flex items-center justify-center gap-2"
        >
          <Mail class="w-3.5 h-3.5 text-[#ff8600]" />
          <span>Email</span>
        </a>

        <!-- GitHub Link -->
        <a 
          href="https://github.com/Nekoplii" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2.5 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] border border-white/10 text-xs font-mono text-slate-300 hover:text-white transition-colors flex items-center justify-center gap-2"
        >
          <GitBranch class="w-3.5 h-3.5 text-[#ff8600]" />
          <span>GitHub</span>
        </a>
      </div>

      <!-- Bottom Meta -->
      <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 pt-2 border-t border-white/5">
        <span>UTC+7 • INDONESIA</span>
        <span class="text-[#ff8600]">MAFLY // 2026</span>
      </div>
    </div>
  </aside>
</div>

<script>
  const root = document.getElementById('sidebar-drawer-root');
  const backdrop = document.getElementById('sidebar-backdrop');
  const panel = document.getElementById('sidebar-panel');
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const closeBtn = document.getElementById('sidebar-close-btn');
  const navLinks = document.querySelectorAll('.sidebar-nav-link');

  let isOpen = false;

  function openSidebar() {
    if (!root || !backdrop || !panel) return;
    isOpen = true;
    root.classList.remove('pointer-events-none');
    root.classList.add('pointer-events-auto');
    root.classList.remove('opacity-0');
    root.setAttribute('aria-hidden', 'false');

    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');

    panel.classList.remove('translate-x-full');
    panel.classList.add('translate-x-0');

    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    if (!root || !backdrop || !panel) return;
    isOpen = false;
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');

    panel.classList.remove('translate-x-0');
    panel.classList.add('translate-x-full');

    setTimeout(() => {
      if (!isOpen) {
        root.classList.remove('pointer-events-auto');
        root.classList.add('pointer-events-none');
        root.classList.add('opacity-0');
        root.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }, 300);
  }

  if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  if (backdrop) backdrop.addEventListener('click', closeSidebar);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeSidebar();
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeSidebar();
    }
  });
</script>
