---
// SidebarDrawer.astro - Slide-over navigation with required items: Home, Projects, Workflow, About
import { X, ChevronRight, GitBranch } from 'lucide-astro';
---

<div 
  id="sidebar-drawer-root" 
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 opacity-0"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div 
    id="sidebar-backdrop" 
    class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0"
  ></div>

  <!-- Slide-out Drawer Panel -->
  <aside 
    id="sidebar-panel" 
    class="absolute top-0 right-0 bottom-0 w-full max-w-md bg-[#0f121a]/95 backdrop-blur-2xl border-l border-white/10 shadow-2xl p-6 sm:p-8 flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
  >
    <!-- Header: Brand & Close Button -->
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <div class="flex items-center gap-3">
        <img 
          src="https://assets.viidev.my.id/images/logo/main.png" 
          alt="Mafly Logo" 
          class="h-8 w-auto object-contain"
        />
        <div>
          <span class="text-sm font-bold text-white tracking-tight">Mafly</span>
          <p class="text-[11px] text-slate-400">Software & Systems Engineering</p>
        </div>
      </div>

      <button 
        id="sidebar-close-btn"
        aria-label="Close sidebar"
        class="p-2 rounded-full glass-card hover:bg-white/10 text-slate-400 hover:text-white transition-colors cursor-pointer"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Main Navigation Items (Home, Projects, Workflow, About) -->
    <nav class="py-8 space-y-2">
      <p class="text-xs font-mono uppercase tracking-widest text-[#ff8600] font-semibold mb-4">Directory</p>

      <!-- 1. Home -->
      <a 
        href="/" 
        class="sidebar-nav-link group flex items-center justify-between p-3.5 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-[#ff8600]">01</span>
          <div>
            <span class="text-base font-semibold text-white group-hover:text-[#ff8600] transition-colors">Home</span>
            <p class="text-xs text-slate-400">Overview, systems engineering & 3D grid</p>
          </div>
        </div>
        <ChevronRight class="w-4 h-4 text-slate-500 group-hover:text-[#ff8600] group-hover:translate-x-1 transition-all" />
      </a>

      <!-- 2. Projects -->
      <a 
        href="#projects" 
        class="sidebar-nav-link group flex items-center justify-between p-3.5 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-[#ff8600]">02</span>
          <div>
            <span class="text-base font-semibold text-white group-hover:text-[#ff8600] transition-colors">Projects</span>
            <p class="text-xs text-slate-400">Open-source software, desktop & web apps</p>
          </div>
        </div>
        <ChevronRight class="w-4 h-4 text-slate-500 group-hover:text-[#ff8600] group-hover:translate-x-1 transition-all" />
      </a>

      <!-- 3. TechStack -->
      <a 
        href="#techstack" 
        class="sidebar-nav-link group flex items-center justify-between p-3.5 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-[#ff8600]">03</span>
          <div>
            <span class="text-base font-semibold text-white group-hover:text-[#ff8600] transition-colors">TechStack</span>
            <p class="text-xs text-slate-400">Languages, runtimes & system tools</p>
          </div>
        </div>
        <ChevronRight class="w-4 h-4 text-slate-500 group-hover:text-[#ff8600] group-hover:translate-x-1 transition-all" />
      </a>

      <!-- 4. Designs -->
      <a 
        href="#designs" 
        class="sidebar-nav-link group flex items-center justify-between p-3.5 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-[#ff8600]">04</span>
          <div>
            <span class="text-base font-semibold text-white group-hover:text-[#ff8600] transition-colors">Designs</span>
            <p class="text-xs text-slate-400">Architectural visual paradigms & UI systems</p>
          </div>
        </div>
        <ChevronRight class="w-4 h-4 text-slate-500 group-hover:text-[#ff8600] group-hover:translate-x-1 transition-all" />
      </a>
    </nav>

    <!-- Bio Summary Card inside Sidebar -->
    <div class="glass-card p-4 rounded-xl border border-white/10 space-y-2 mb-6">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-200">Focus Areas</span>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#ff8600]/15 text-[#ff8600] border border-[#ff8600]/30">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ff8600] animate-pulse"></span>
          Active
        </span>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Building functional software, open-source utilities, and managing backend infrastructure across Linux servers.
      </p>
    </div>

    <!-- Footer: Socials & Direct Email -->
    <div class="pt-6 border-t border-white/10 space-y-4">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Connect via GitHub</span>
        <a href="https://github.com/Nekoplii" target="_blank" rel="noopener noreferrer" class="text-[#ff8600] hover:underline font-mono">@Nekoplii</a>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="https://github.com/Nekoplii" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 py-2 text-center rounded-lg glass-card hover:bg-white/10 text-xs font-medium text-slate-300 hover:text-white border border-white/10 transition-colors flex items-center justify-center gap-2"
        >
          <GitBranch class="w-4 h-4" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </aside>
</div>

<script>
  const root = document.getElementById('sidebar-drawer-root');
  const backdrop = document.getElementById('sidebar-backdrop');
  const panel = document.getElementById('sidebar-panel');
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const closeBtn = document.getElementById('sidebar-close-btn');
  const navLinks = document.querySelectorAll('.sidebar-nav-link');

  let isOpen = false;

  function openSidebar() {
    if (!root || !backdrop || !panel) return;
    isOpen = true;
    root.classList.remove('pointer-events-none');
    root.classList.add('pointer-events-auto');
    root.classList.remove('opacity-0');
    root.setAttribute('aria-hidden', 'false');

    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');

    panel.classList.remove('translate-x-full');
    panel.classList.add('translate-x-0');

    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    if (!root || !backdrop || !panel) return;
    isOpen = false;
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');

    panel.classList.remove('translate-x-0');
    panel.classList.add('translate-x-full');

    setTimeout(() => {
      if (!isOpen) {
        root.classList.remove('pointer-events-auto');
        root.classList.add('pointer-events-none');
        root.classList.add('opacity-0');
        root.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }, 300);
  }

  if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  if (backdrop) backdrop.addEventListener('click', closeSidebar);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeSidebar();
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeSidebar();
    }
  });
</script>
