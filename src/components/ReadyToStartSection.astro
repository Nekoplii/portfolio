---
// ReadyToStartSection.astro - Final CTA & Contact in Architectural Card Matrix
import { Send, CheckCircle2 } from 'lucide-astro';
---

<section id="contact" class="py-20 sm:py-28 relative -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 border-t border-white/10">
  <!-- Container Intersection Crosshairs '+' aligned with max-w-7xl borders -->
  <div class="absolute -top-2.5 -left-1.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-20 hidden sm:block">+</div>
  <div class="absolute -top-2.5 -right-1.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-20 hidden sm:block">+</div>

  <!-- Centered Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
    <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">
      Get in <span class="bg-gradient-to-r from-[#ff8600] to-[#ffa033] bg-clip-text text-transparent">Touch</span>
    </h2>
    <p class="text-slate-400 text-sm sm:text-base mt-3">
      Let's discuss system architecture, new tools, or technical collaboration.
    </p>
  </div>

  <!-- Connected Architectural Grid Line Matrix Card (matching Featured Projects) -->
  <div class="relative rounded-2xl border border-white/10 bg-[#0d0f15] overflow-hidden shadow-2xl">
    
    <!-- Outer Corner Crosshairs '+' -->
    <div class="absolute top-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
    <div class="absolute top-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
    <div class="absolute bottom-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
    <div class="absolute bottom-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>

    <!-- Top Meta Bar (Connected Horizontal Divider Line running edge-to-edge) -->
    <div class="w-full px-6 sm:px-8 py-3.5 border-b border-white/10 flex items-center justify-between font-mono text-xs">
      <span class="text-[#ff8600] font-semibold">05 //</span>
      <span class="text-slate-400">INQUIRY CHANNEL</span>
    </div>

    <!-- Content Columns: Left Info & Right Interactive Form separated by single-pixel divider line -->
    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-white/10">
      
      <!-- Left Column: Details & Channels (5 cols on lg) -->
      <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-6">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
            Let's Build Something Resilient
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
            Whether you need high-performance web tooling, backend infrastructure consulting, or desktop software, reach out directly.
          </p>

          <!-- Direct Email Box -->
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 space-y-2 mb-6">
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block">Direct Inquiries</span>
            <div class="flex items-center justify-between">
              <a href="mailto:contact@viidev.my.id" class="text-xs sm:text-sm font-semibold text-white hover:text-[#ff8600] transition-colors font-mono">
                contact@viidev.my.id
              </a>
              <button 
                id="copy-email-btn"
                type="button"
                class="px-2.5 py-1 text-xs rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-all cursor-pointer font-mono"
              >
                Copy
              </button>
            </div>
          </div>

          <!-- Working Hours & Availability -->
          <div class="space-y-2.5 text-xs font-mono text-slate-400">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-slate-200">Response time: Usually within 24 hours</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#ff8600]">📍</span>
              <span>Remote Worldwide • UTC+7</span>
            </div>
          </div>
        </div>

        <!-- Bottom Security Note -->
        <div class="pt-4 border-t border-white/5 text-[11px] font-mono text-slate-500 flex items-center justify-between">
          <span>ENCRYPTED // TLS 1.3</span>
          <span class="text-emerald-400">STATUS: READY</span>
        </div>
      </div>

      <!-- Right Column: Interactive Inquiry Form (7 cols on lg) -->
      <div class="lg:col-span-7 p-6 sm:p-8">
        <form id="contact-form" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Name -->
            <div class="space-y-1.5">
              <label for="contact-name" class="text-xs font-mono text-slate-300">Your Name *</label>
              <input 
                type="text" 
                id="contact-name" 
                required
                placeholder="e.g. Alex Vance"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#ff8600] focus:ring-1 focus:ring-[#ff8600] transition-all"
              />
            </div>

            <!-- Email -->
            <div class="space-y-1.5">
              <label for="contact-email" class="text-xs font-mono text-slate-300">Email Address *</label>
              <input 
                type="email" 
                id="contact-email" 
                required
                placeholder="alex@company.com"
                class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#ff8600] focus:ring-1 focus:ring-[#ff8600] transition-all"
              />
            </div>
          </div>

          <!-- Project Category Interest -->
          <div class="space-y-2">
            <label class="text-xs font-mono text-slate-300">Project Type *</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <label class="cursor-pointer">
                <input type="radio" name="projectType" value="web-app" class="peer sr-only" checked />
                <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 peer-checked:border-[#ff8600] peer-checked:bg-[#ff8600]/15 peer-checked:text-[#ff8600] text-center text-xs font-medium text-slate-300 transition-all">
                  Web App
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="projectType" value="infra" class="peer sr-only" />
                <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 peer-checked:border-[#ff8600] peer-checked:bg-[#ff8600]/15 peer-checked:text-[#ff8600] text-center text-xs font-medium text-slate-300 transition-all">
                  Infrastructure
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="projectType" value="desktop-tool" class="peer sr-only" />
                <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 peer-checked:border-[#ff8600] peer-checked:bg-[#ff8600]/15 peer-checked:text-[#ff8600] text-center text-xs font-medium text-slate-300 transition-all">
                  Desktop Tool
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="projectType" value="other" class="peer sr-only" />
                <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 peer-checked:border-[#ff8600] peer-checked:bg-[#ff8600]/15 peer-checked:text-[#ff8600] text-center text-xs font-medium text-slate-300 transition-all">
                  Other / Collab
                </div>
              </label>
            </div>
          </div>

          <!-- Message -->
          <div class="space-y-1.5">
            <label for="contact-msg" class="text-xs font-mono text-slate-300">Project Overview / Goals *</label>
            <textarea 
              id="contact-msg" 
              rows="4" 
              required
              placeholder="Tell me about your product timeline, goals, and technical preferences..."
              class="w-full px-4 py-3 rounded-xl bg-white/[0.04] border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#ff8600] focus:ring-1 focus:ring-[#ff8600] transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="contact-submit-btn"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-black bg-[#ff8600] hover:bg-[#ff9c2b] transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]"
          >
            <span id="submit-btn-text">Transmit Project Proposal</span>
            <Send class="w-4 h-4" />
          </button>

          <!-- Feedback Toast Message -->
          <div id="contact-success-msg" class="hidden p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-mono flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 flex-shrink-0" />
            <span>Thank you! Your inquiry has been received. I will review it and reply within 24 hours.</span>
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('contact-success-msg');
  const submitBtn = document.getElementById('contact-submit-btn');
  const submitText = document.getElementById('submit-btn-text');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('contact@viidev.my.id');
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 2000);
    });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (submitText && submitBtn) {
        submitText.textContent = 'Sending...';
        submitBtn.setAttribute('disabled', 'true');

        setTimeout(() => {
          submitText.textContent = 'Proposal Transmitted ✓';
          form.reset();
          if (successMsg) successMsg.classList.remove('hidden');

          setTimeout(() => {
            submitText.textContent = 'Transmit Project Proposal';
            submitBtn.removeAttribute('disabled');
          }, 4000);
        }, 800);
      }
    });
  }
</script>
