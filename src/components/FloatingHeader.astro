---
// FloatingHeader.astro - max-w-4xl floating glassmorphic navigation with mobile-only breadcrumbs
import { ChevronDown, ArrowUpRight, Menu } from 'lucide-astro';
---

<header class="fixed top-3 sm:top-6 left-0 right-0 z-50 px-3 sm:px-4 pointer-events-none transition-all duration-300">
  <div class="max-w-4xl mx-auto pointer-events-auto">
    <nav class="glass-panel px-3.5 sm:px-6 py-2 sm:py-2.5 rounded-full flex items-center justify-between border border-white/10 shadow-2xl shadow-black/60 backdrop-blur-xl">
      
      <!-- Brand Logo (Clean without circle) & Mobile-Only Breadcrumb -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <img 
            src="https://assets.viidev.my.id/images/logo/main.png" 
            alt="Viidev Logo" 
            class="h-7 w-auto object-contain"
            loading="eager"
          />
          <span class="text-sm font-bold tracking-tight text-white group-hover:text-[#ff8600] transition-colors">
            Viidev
          </span>
        </a>

        <!-- Mobile-Only Breadcrumbs: strictly hidden on desktop (md:hidden), clickable to open sidebar -->
        <button 
          id="mobile-breadcrumb-trigger" 
          type="button"
          class="flex md:hidden items-center text-xs font-mono text-slate-400 pl-1.5 border-l border-white/10 hover:text-white transition-colors cursor-pointer group/crumb"
          aria-label="Open navigation sidebar"
        >
          <span class="text-slate-500 mr-1.5">/</span>
          <span id="mobile-breadcrumb" class="text-[#ff8600] font-semibold tracking-wide">Home</span>
          <ChevronDown class="w-3 h-3 ml-1 text-slate-400 group-hover/crumb:text-[#ff8600] transition-colors" />
        </button>
      </div>

      <!-- Desktop Nav Items: Home, Projects, TechStack, Designs (Strictly Desktop) -->
      <div class="hidden md:flex items-center gap-1.5 text-sm font-medium text-slate-300">
        <a 
          href="/" 
          class="nav-link px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors"
          data-target="hero"
        >
          Home
        </a>
        <a 
          href="#projects" 
          class="nav-link px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors"
          data-target="projects"
        >
          Projects
        </a>
        <a 
          href="#techstack" 
          class="nav-link px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors"
          data-target="techstack"
        >
          TechStack
        </a>
        <a 
          href="#designs" 
          class="nav-link px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors"
          data-target="designs"
        >
          Designs
        </a>
      </div>

      <!-- Right Action Items (Simple hover without shadows) -->
      <div class="flex items-center gap-2">
        <a 
          href="#contact" 
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-black bg-[#ff8600] hover:bg-[#ff9c2b] transition-colors active:scale-95"
        >
          <span>Contact</span>
          <ArrowUpRight class="w-3.5 h-3.5" />
        </a>

        <!-- Sidebar Drawer Toggle Button (Simple hover without shadows) -->
        <button 
          id="sidebar-toggle-btn"
          aria-label="Open sidebar menu"
          class="p-2 rounded-full glass-card hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors cursor-pointer"
        >
          <Menu class="w-4 h-4" />
        </button>
      </div>

    </nav>
  </div>
</header>

<script>
  // Mobile Breadcrumb & Active Section Spy
  const breadcrumb = document.getElementById('mobile-breadcrumb');
  const breadcrumbTrigger = document.getElementById('mobile-breadcrumb-trigger');
  const sidebarToggleBtn = document.getElementById('sidebar-toggle-btn');

  // Breadcrumb opens sidebar on mobile
  if (breadcrumbTrigger && sidebarToggleBtn) {
    breadcrumbTrigger.addEventListener('click', () => {
      sidebarToggleBtn.click();
    });
  }

  const sections = [
    { id: 'hero', name: 'Home' },
    { id: 'projects', name: 'Projects' },
    { id: 'techstack', name: 'TechStack' },
    { id: 'designs', name: 'Designs' },
    { id: 'contact', name: 'Contact' }
  ];

  function updateActiveNav() {
    const scrollPos = window.scrollY + 160;
    let current = 'Home';

    for (const section of sections) {
      const el = document.getElementById(section.id);
      if (el) {
        const top = el.offsetTop;
        const height = el.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          current = section.name;
          break;
        }
      }
    }

    if (breadcrumb && breadcrumb.textContent !== current) {
      breadcrumb.textContent = current;
    }
  }

  window.addEventListener('scroll', updateActiveNav, { passive: true });
  updateActiveNav();
</script>
