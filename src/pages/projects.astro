---
// src/pages/projects.astro - Independent Projects Page
import { ArrowUpRight, Copy, ExternalLink, GitBranch, Mail } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    index: '01',
    title: 'Billmora',
    category: 'OPEN SOURCE',
    description: 'Open-source billing management software with automated service provisioning and recurring invoice automation.',
    image: 'https://camo.githubusercontent.com/7bb4dcdc63351ab96d410a624764c78e1eca78e0be3b0ac7b33ebab1ca3b13ce/68747470733a2f2f6d656469612e62696c6c6d6f72612e636f6d2f696d6167652f61646d696e2d64617368626f6172642e706e67',
    tech: ['Laravel', 'PHP', 'MySQL', 'TailwindCSS'],
    previewUrl: 'https://billmora.com/demo',
    repoUrl: 'https://github.com/Billmora/billmora'
  },
  {
    index: '02',
    title: 'Octavia Company Page',
    category: 'COMPANY PLATFORM',
    description: 'Hosting platform interface and company portal for game servers, microservices, and databases.',
    image: 'https://assets.octavia.id/assets/frame/homepage.png',
    tech: ['Astro', 'TypeScript', 'TailwindCSS'],
    previewUrl: 'https://octavia.id/',
    repoUrl: ''
  },
  {
    index: '03',
    title: 'BDEV CLI',
    category: 'DEVELOPER TOOLING',
    description: 'Command-line developer tool for building, packaging, and hot-reloading Minecraft Bedrock Edition addons.',
    image: '',
    tech: ['Rust', 'Node.js', 'CLI'],
    previewUrl: '',
    repoUrl: 'https://github.com/Nekoplii/bdev'
  }
];
---

<Layout 
  title="Projects • Mafly"
  description="Explore software projects, open-source repositories, and developer tooling by Mafly."
>
  <!-- Generous top spacing to prevent header obstruction -->
  <div class="pt-44 sm:pt-52 pb-24 sm:pb-32">
    
    <!-- Centered Page Header with ample breathing room -->
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ff8600]/10 border border-[#ff8600]/25 text-xs font-mono text-[#ff8600] mb-4">
        <span>01 // DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.15]">
        Explore <span class="bg-gradient-to-r from-[#ff8600] to-[#ffa033] bg-clip-text text-transparent">Projects</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-3 leading-relaxed">
        Selected software, web platforms, and developer tooling.
      </p>
    </div>

    <!-- 1. Projects Matrix Card (3 Columns) -->
    <div class="relative rounded-2xl border border-white/10 bg-[#0f121a] overflow-hidden shadow-2xl mb-24 sm:mb-32">
      
      <!-- Outer Corner Crosshairs '+' -->
      <div class="absolute top-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute top-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute bottom-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute bottom-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>

      <!-- Top Meta Bar -->
      <div class="w-full px-6 sm:px-8 py-3.5 border-b border-white/10 flex items-center justify-between font-mono text-xs">
        <span class="text-[#ff8600] font-semibold">01 //</span>
        <span class="text-slate-400">PROJECT DIRECTORY</span>
      </div>

      <!-- 3 Columns divided by single-pixel lines -->
      <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-white/10">
        {projects.map((project) => (
          <article class="p-6 sm:p-8 flex flex-col justify-between group hover:bg-white/[0.01] transition-colors">
            <div>
              <!-- Meta bar inside card -->
              <div class="flex items-center justify-between pb-3 mb-5 border-b border-white/10 font-mono text-xs">
                <span class="text-[#ff8600] font-semibold">{project.index} //</span>
                <span class="text-slate-400 text-[11px]">{project.category}</span>
              </div>

              <!-- Thumbnail: Uses image if available; otherwise displays strictly title text -->
              <div class="relative w-full aspect-[16/10] rounded-xl overflow-hidden mb-6 bg-[#151923] border border-white/10 group-hover:border-[#ff8600]/30 transition-all flex items-center justify-center">
                {project.image && project.image.trim() !== '' ? (
                  <div class="w-full h-full relative flex items-center justify-center">
                    <img 
                      src={project.image} 
                      alt={project.title} 
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                      loading="lazy"
                      onerror="this.style.display='none'; if(this.nextElementSibling) { this.nextElementSibling.classList.remove('hidden'); this.nextElementSibling.classList.add('flex'); }"
                    />
                    <div class="hidden absolute inset-0 bg-[#151923] items-center justify-center p-6 text-center select-none">
                      <span class="text-lg sm:text-xl font-bold font-mono text-slate-200 group-hover:text-[#ff8600] transition-colors tracking-tight px-4">
                        {project.title}
                      </span>
                    </div>
                  </div>
                ) : (
                  <div class="w-full h-full flex items-center justify-center p-6 text-center select-none bg-[#151923]">
                    <span class="text-lg sm:text-xl font-bold font-mono text-slate-200 group-hover:text-[#ff8600] transition-colors tracking-tight px-4">
                      {project.title}
                    </span>
                  </div>
                )}
              </div>

              <!-- Title -->
              <h2 class="text-xl font-bold text-white group-hover:text-[#ff8600] transition-colors mb-2">
                {project.title}
              </h2>

              <!-- Description: Concise, direct, authentic -->
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
                {project.description}
              </p>

              <!-- Technologies -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {project.tech.map((t) => (
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/10 text-xs font-mono text-slate-300">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Links -->
            <div class="pt-4 border-t border-white/10 flex items-center gap-3 font-mono text-xs">
              {project.previewUrl && (
                <a 
                  href={project.previewUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex-1 py-2 px-3 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 hover:text-white transition-colors flex items-center justify-center gap-1.5 group/link"
                >
                  <span>Preview</span>
                  <ExternalLink class="w-3.5 h-3.5 text-[#ff8600] group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform" />
                </a>
              )}
              {project.repoUrl && (
                <a 
                  href={project.repoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex-1 py-2 px-3 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 hover:text-white transition-colors flex items-center justify-center gap-1.5 group/link"
                >
                  <GitBranch class="w-3.5 h-3.5 text-[#ff8600]" />
                  <span>Repository</span>
                  <ArrowUpRight class="w-3.5 h-3.5 text-slate-500 group-hover/link:text-white transition-colors" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>

    </div>

    <!-- 2. Have an Idea / Open for Collaboration Card (With generous gap above) -->
    <div class="relative rounded-2xl border border-white/10 bg-[#0f121a] overflow-hidden shadow-2xl">
      
      <!-- Outer Corner Crosshairs '+' -->
      <div class="absolute top-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute top-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute bottom-2 left-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>
      <div class="absolute bottom-2 right-2.5 font-mono text-[11px] text-white/30 pointer-events-none select-none z-10">+</div>

      <!-- Top Meta Bar -->
      <div class="w-full px-6 sm:px-8 py-3.5 border-b border-white/10 flex items-center justify-between font-mono text-xs">
        <span class="text-[#ff8600] font-semibold">02 //</span>
        <span class="text-slate-400">OPEN FOR COLLABORATION</span>
      </div>

      <!-- Content Columns: Left Info & Right Direct Email Action -->
      <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-white/10">
        
        <!-- Left Column: Context & Availability -->
        <div class="lg:col-span-7 p-6 sm:p-10 flex flex-col justify-center space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-xs w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Available for new projects</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Have an idea or project in mind?
          </h3>
          
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-lg">
            Feel free to reach out directly. I'm always open to discussing new opportunities, systems architecture, or engineering collaborations.
          </p>
        </div>

        <!-- Right Column: Direct Email & Action -->
        <div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-center gap-4 bg-white/[0.01]">
          <!-- Direct Email Box with 1-click Copy -->
          <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <span class="text-xs sm:text-sm font-mono text-slate-200 select-all truncate">
              code.mafly@gmail.com
            </span>
            <button 
              id="copy-email-btn"
              type="button"
              aria-label="Copy email address"
              class="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-all cursor-pointer font-mono shrink-0 active:scale-95"
            >
              <Copy class="w-3.5 h-3.5" />
              <span id="copy-btn-text">Copy</span>
            </button>
          </div>

          <!-- Direct mailto Action Button -->
          <a 
            href="mailto:code.mafly@gmail.com" 
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-black bg-[#ff8600] hover:bg-[#ff9c2b] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#ff8600]/20 active:scale-[0.99] text-sm group"
          >
            <Mail class="w-4 h-4" />
            <span>Send an Email</span>
            <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
          </a>
        </div>

      </div>

    </div>

  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-btn-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('code.mafly@gmail.com');
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }
</script>
